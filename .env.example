# ==========================================================================
# Warp Engine — Environment Variables (template)
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit `.env` or real secrets to the repository.
# ==========================================================================

# --- Application ---
APP_ENV=development            # development | production
LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=colored             # colored | json (defaults to json in production)

# Comma-separated CORS allowlist.
# "*" is REJECTED at startup when APP_ENV=production — set explicit origins there,
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# Uvicorn server (used by the `warp` entrypoint / `make`)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Path to the YAML config consumed by the app
CONFIG_PATH=./config/database.yaml

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=postgres
DB_PASS=                       # REQUIRED — set a strong password
# Optional: read-only role used ONLY by the raw SQL endpoint (defense in depth).
DB_READONLY_USER=
DB_READONLY_PASS=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=testdb
MYSQL_USER=root
MYSQL_PASS=                    # REQUIRED — set a strong password
# Optional: read-only role used ONLY by the raw SQL endpoint (defense in depth).
MYSQL_READONLY_USER=
MYSQL_READONLY_PASS=

# --- SQL Server (optional; `make docker-up-mssql`, `type: mssql` in database.yaml) ---
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=master                # or a database you created (make db-shell-mssql)
MSSQL_USER=sa
MSSQL_PASS=                    # REQUIRED for the mssql profile — SQL Server enforces a strong password

# --- API keys (consumed by config/database.yaml -> auth.api_keys) ---
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=
API_KEY_READONLY=
API_KEY_WRITER=

# --- LLM provider (catalog intelligence) ---
LLM_PROVIDER=ollama            # openai | anthropic | gemini | ollama
LLM_MODEL=gemma3:1b
LLM_API_KEY=                   # required for cloud providers (openai/anthropic/gemini)
LLM_BASE_URL=http://localhost:11434
